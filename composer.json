{
    "name": "terah/fluent-assert",
    "description": "A light weight assertion package based on beberlei/assert",
    "keywords": [
        "terah",
        "fluent-assert"
    ],
    "homepage": "https://github.com/terah/fluent-assert",
    "license": "MIT",
    "authors": [
        {
            "name": "Terry Cullen",
            "email": "terry@terah.com.au",
            "homepage": "http://terah.com.au",
            "role": "Developer"
        }
    ],
    "bin": ["bin/tester"],
    "require": {
        "php" : ">=7.0"
    },
    "require-dev": {
        "scrutinizer/ocular": "~1.1"
    },
    "autoload": {
        "psr-4": {
            "Terah\\Assert\\": "src"
        },
        "files": ["src/functions.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Terah\\Assert\\Test\\": "tests"
        }
    }
}
